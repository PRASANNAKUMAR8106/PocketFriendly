# Supabase Configuration
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Payment Gateway Configuration (Razorpay)
# Razorpay Key ID (Public, safe for frontend client)
VITE_RAZORPAY_KEY_ID=rzp_test_yourkeyhere

# Optional: Store Meta
VITE_APP_NAME="PocketFriendly Sarees"
VITE_SITE_URL=https://pocketfriendlysarees.com
